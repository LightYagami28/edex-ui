<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>edex-ui</id>
    <version>@VERSION@</version>
    <title>eDEX-UI</title>
    <authors>Light Yagami</authors>
    <owners>LightYagami28</owners>
    <projectUrl>https://github.com/LightYagami28/edex-ui</projectUrl>
    <packageSourceUrl>https://github.com/LightYagami28/edex-ui/tree/master/packaging/windows/chocolatey</packageSourceUrl>
    <bugTrackerUrl>https://github.com/LightYagami28/edex-ui/issues</bugTrackerUrl>
    <licenseUrl>https://github.com/LightYagami28/edex-ui/blob/master/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>edex-ui terminal shell sci-fi cli</tags>
    <summary>Terminale a schermo intero in stile fantascienza con pannelli di sistema.</summary>
    <description>eDEX-UI nativo (.NET) con pannelli di sistema (CPU, RAM, rete, processi, file) e tastiera su schermo. Eseguibile autonomo, non richiede il runtime .NET. Il pacchetto scarica lo zip della release GitHub e ne verifica la somma SHA-256.</description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
